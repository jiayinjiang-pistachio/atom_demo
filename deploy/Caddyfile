{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	# SSE is served under /api/*: never compress there, otherwise the event
	# stream can be buffered and the UI only updates after a refresh.
	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /healthz {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy web:80
	}
}

{$PREVIEW_DOMAIN} {
	encode zstd gzip

	@preview path /preview/*
	handle @preview {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle {
		respond "Not found" 404
	}
}
