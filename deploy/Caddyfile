{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /healthz {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:80
	}
}

{$PREVIEW_DOMAIN} {
	encode zstd gzip

	@preview path /preview/*
	handle @preview {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle {
		respond "Not found" 404
	}
}
