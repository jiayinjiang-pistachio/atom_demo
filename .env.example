# Copy to .env and fill in. Never commit real secrets.

# MySQL (compose)
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# App / preview public origins (no trailing slash)
APP_DOMAIN=atom.example.com
PREVIEW_DOMAIN=preview.atom.example.com
ACME_EMAIL=you@example.com

FRONTEND_ORIGIN=https://atom.example.com
PREVIEW_ORIGIN=https://preview.atom.example.com
PREVIEW_HOST=preview.atom.example.com

# DeepSeek
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-key
LLM_MODEL=deepseek-chat
LLM_MODE=auto

# Limits
ENVIRONMENT=production
MAX_RUNS_PER_GUEST_DAY=20
MAX_STEPS=24
MAX_FILE_BYTES=32768
